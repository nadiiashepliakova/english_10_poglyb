        if (activeDeck.length === 0) return;

        const card = activeDeck[flashIndex];

        if (flashDirection === 'phrase-to-translation') {
            flashFrontText.textContent = card.phrase;
            flashBackText.textContent = card.translation;
        } else {
            flashFrontText.textContent = card.translation;
            flashBackText.textContent = card.phrase;
        }

        flashCounter.textContent = `${flashIndex + 1} / ${activeDeck.length}`;
        const progressPercent = ((flashIndex + 1) / activeDeck.length) * 100;
        flashProgressBar.style.width = `${progressPercent}%`;

        flashPrev.disabled = flashIndex === 0;
        flashNext.disabled = flashIndex === activeDeck.length - 1;

        resetFlip();

        dirButtons.forEach(btn => {
            btn.classList.toggle('active', btn.dataset.dir === flashDirection);
        });
    }

    function flashPrevHandler() {
        if (flashIndex > 0) { flashIndex--; renderFlashcard(); }
    }
    function flashNextHandler() {
        if (flashIndex < activeDeck.length - 1) { flashIndex++; renderFlashcard(); }
    }

    function shuffleFlashDeck() {
        if (activeDeck.length <= 1) return;
        shuffleArray(activeDeck);
        flashIndex = 0;
        renderFlashcard();
    }

    function setDirection(dir) {
        if (flashDirection === dir) return;
        flashDirection = dir;
        renderFlashcard();
