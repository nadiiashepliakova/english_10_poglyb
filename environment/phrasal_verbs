    const MATCH_TOTAL = wordList.length;
    let selectedPhraseId = null;
    let selectedDefId = null;
    let pairs = [];
    let checkResults = null;

    const matchPhrasesEl = document.getElementById('matchPhrases');
    const matchDefinitionsEl = document.getElementById('matchDefinitions');
    const matchPairedCountEl = document.getElementById('matchPairedCount');
    const matchScoreEl = document.getElementById('matchScore');
    const matchCheckBtn = document.getElementById('matchCheckBtn');
    const matchResetBtn = document.getElementById('matchResetBtn');
    const matchResultEl = document.getElementById('matchResult');

    function isPhrasePaired(phraseId) { return pairs.some(p => p.phraseId === phraseId); }
    function isDefPaired(defId) { return pairs.some(p => p.defId === defId); }
    function getPairByPhrase(phraseId) { return pairs.find(p => p.phraseId === phraseId); }
    function getPairByDef(defId) { return pairs.find(p => p.defId === defId); }

    let matchPhraseOrder = [];
    let matchDefOrder = [];

    function renderMatchingBoard() {
        matchPhrasesEl.innerHTML = '';
        matchPhraseOrder.forEach(phraseId => {
            const word = wordList[phraseId];
            const btn = document.createElement('button');
            btn.className = 'match-item';
            btn.dataset.phraseId = phraseId;

            if (isPhrasePaired(phraseId)) btn.classList.add('matched', 'disabled');
            if (selectedPhraseId === phraseId && !isPhrasePaired(phraseId)) btn.classList.add('selected');
            if (checkResults) {
                const pair = getPairByPhrase(phraseId);
                if (pair) btn.classList.add(pair.defId === phraseId ? 'correct-pair' : 'wrong-pair');
            }

            const badge = document.createElement('span');
            badge.className = 'badge';
            badge.textContent = String.fromCharCode(65 + matchPhraseOrder.indexOf(phraseId));

            const text = document.createElement('span');
            text.className = 'text';
            text.textContent = word.phrase;

            btn.appendChild(badge);
            btn.appendChild(text);
            btn.addEventListener('click', () => handlePhraseClick(phraseId));
            matchPhrasesEl.appendChild(btn);
        });

        matchDefinitionsEl.innerHTML = '';
        matchDefOrder.forEach(defId => {
            const word = wordList[defId];
            const btn = document.createElement('button');
            btn.className = 'match-item';
            btn.dataset.defId = defId;

            if (isDefPaired(defId)) btn.classList.add('matched', 'disabled');
            if (selectedDefId === defId && !isDefPaired(defId)) btn.classList.add('selected');
            if (checkResults) {
                const pair = getPairByDef(defId);
                if (pair) btn.classList.add(pair.phraseId === defId ? 'correct-pair' : 'wrong-pair');
            }

            const badge = document.createElement('span');
            badge.className = 'badge';
            badge.textContent = String.fromCharCode(65 + matchDefOrder.indexOf(defId));

            const text = document.createElement('span');
            text.className = 'text';
            text.textContent = word.definition;

            btn.appendChild(badge);
            btn.appendChild(text);
            btn.addEventListener('click', () => handleDefClick(defId));
            matchDefinitionsEl.appendChild(btn);
        });

        matchPairedCountEl.textContent = pairs.length;
        if (checkResults) {
            matchScoreEl.textContent = pairs.filter(p => p.phraseId === p.defId).length;
        } else {
            matchScoreEl.textContent = '—';
        }
        matchCheckBtn.disabled = pairs.length === 0 || checkResults !== null;
    }

    function handlePhraseClick(phraseId) {
        if (checkResults || isPhrasePaired(phraseId)) return;
        selectedPhraseId = (selectedPhraseId === phraseId) ? null : phraseId;
        if (selectedPhraseId !== null && selectedDefId !== null) {
            createPair(selectedPhraseId, selectedDefId);
            selectedPhraseId = null;
            selectedDefId = null;
        }
        renderMatchingBoard();
    }

    function handleDefClick(defId) {
        if (checkResults || isDefPaired(defId)) return;
        selectedDefId = (selectedDefId === defId) ? null : defId;
        if (selectedPhraseId !== null && selectedDefId !== null) {
            createPair(selectedPhraseId, selectedDefId);
            selectedPhraseId = null;
            selectedDefId = null;
        }
        renderMatchingBoard();
    }

    function createPair(phraseId, defId) {
        if (isPhrasePaired(phraseId) || isDefPaired(defId)) return;
        pairs.push({ phraseId, defId });
    }

    function checkMatching() {
        if (pairs.length === 0) return;
        checkResults = pairs.map(p => ({
            phraseId: p.phraseId,
            defId: p.defId,
            correct: p.phraseId === p.defId
        }));

        const correctCount = checkResults.filter(r => r.correct).length;
        const total = MATCH_TOTAL;

        matchScoreEl.textContent = correctCount;
        matchResultEl.className = 'match-result show';
        if (correctCount === total) {
            matchResultEl.classList.add('perfect');
            matchResultEl.innerHTML = `🏆 Perfect! You have matched all ${total} pairs! Your score: <strong>${correctCount} / ${total}</strong> points.`;
        } else if (correctCount >= total / 2) {
            matchResultEl.classList.add('good');
            matchResultEl.innerHTML = `👍 Good! You have got <strong>${correctCount} / ${total}</strong> points. Try again to improve your result.`;
        } else {
            matchResultEl.classList.add('poor');
            matchResultEl.innerHTML = `🤔 You have got <strong>${correctCount} / ${total}</strong> points. Practise Flashcards 2 Set one more time and try again.`;
        }

        matchCheckBtn.disabled = true;
        renderMatchingBoard();
    }

    function resetMatching() {
        selectedPhraseId = null;
        selectedDefId = null;
        pairs = [];
        checkResults = null;
        matchResultEl.className = 'match-result';
        matchResultEl.innerHTML = '';
        matchPhraseOrder = shuffleArray([...Array(MATCH_TOTAL).keys()]);
        matchDefOrder = shuffleArray([...Array(MATCH_TOTAL).keys()]);
        renderMatchingBoard();
    }

    function initMatching() {
        matchPhraseOrder = shuffleArray([...Array(MATCH_TOTAL).keys()]);
        matchDefOrder = shuffleArray([...Array(MATCH_TOTAL).keys()]);
        pairs = [];
        selectedPhraseId = null;
        selectedDefId = null;
        checkResults = null;

        renderMatchingBoard();
        matchCheckBtn.addEventListener('click', checkMatching);
        matchResetBtn.addEventListener('click', resetMatching);
    }

    // ============================================================
    //  ВПРАВА НА ВВЕДЕННЯ
    // ============================================================
    let typingOrder = [];
    let typingIndex = 0;
    let typingScore = 0;
    let typingAnswered = 0;
    let typingCurrentCompleted = false;

    const typingDefinitionEl = document.getElementById('typingDefinition');
    const typingInput = document.getElementById('typingInput');
    const typingSubmitBtn = document.getElementById('typingSubmitBtn');
    const typingFeedback = document.getElementById('typingFeedback');
    const typingCurrentNumEl = document.getElementById('typingCurrentNum');
    const typingScoreEl = document.getElementById('typingScore');
    const typingNextBtn = document.getElementById('typingNextBtn');
    const typingResetBtn = document.getElementById('typingResetBtn');
    const typingResultEl = document.getElementById('typingResult');
    const typingHintEl = document.getElementById('typingHint');

    function normalizeAnswer(str) {
        return str.trim().toLowerCase().replace(/\s+/g, ' ').replace(/[.!?]+$/, '');
    }
    function normalizePhrase(str) { return normalizeAnswer(str); }

    function renderTypingQuestion() {
        if (typingIndex >= typingOrder.length) {
            typingDefinitionEl.textContent = '🎉 Great Job!';
            typingInput.value = '';
            typingInput.disabled = true;
            typingSubmitBtn.disabled = true;
            typingNextBtn.disabled = true;
            typingCurrentNumEl.textContent = typingOrder.length;
            typingHintEl.textContent = 'Click on «Try again»';

            typingResultEl.className = 'typing-result show';
            if (typingScore === typingOrder.length) {
                typingResultEl.classList.add('perfect');
                typingResultEl.innerHTML = `🏆 Perfect! You have got <strong>${typingScore} / ${typingOrder.length}</strong> points!`;
            } else if (typingScore >= typingOrder.length / 2) {
                typingResultEl.classList.add('good');
                typingResultEl.innerHTML = `👍 Good! You have got <strong>${typingScore} / ${typingOrder.length}</strong> points.`;
            } else {
                typingResultEl.classList.add('poor');
                typingResultEl.innerHTML = `🤔 You have got <strong>${typingScore} / ${typingOrder.length}</strong> points. Try again!`;
            }
            typingFeedback.textContent = '';
            typingFeedback.className = 'typing-feedback';
            return;
        }

        const word = wordList[typingOrder[typingIndex]];
        typingDefinitionEl.textContent = word.definition;
        typingInput.value = '';
        typingInput.disabled = false;
        typingInput.className = 'typing-input';
        typingInput.focus();
        typingSubmitBtn.disabled = false;
        typingNextBtn.disabled = true;
        typingFeedback.textContent = '';
        typingFeedback.className = 'typing-feedback';
        typingResultEl.className = 'typing-result';
        typingHintEl.textContent = 'Type the word and click on «Check»';
        typingCurrentNumEl.textContent = typingIndex + 1;
        typingCurrentCompleted = false;
    }

    function checkTypingAnswer() {
        if (typingCurrentCompleted) return;
        if (typingIndex >= typingOrder.length) return;

        const userAnswer = typingInput.value;
        if (userAnswer.trim() === '') {
            typingFeedback.textContent = 'Please, type your answer.';
            typingFeedback.className = 'typing-feedback wrong-msg';
            return;
        }

        const word = wordList[typingOrder[typingIndex]];
        const normalizedUser = normalizeAnswer(userAnswer);
        const normalizedCorrect = normalizePhrase(word.phrase);
        const isCorrect = normalizedUser === normalizedCorrect;

        typingAnswered++;
        if (isCorrect) {
            typingScore++;
            typingInput.classList.add('correct-input');
            typingFeedback.textContent = '✅ Correct';
            typingFeedback.className = 'typing-feedback correct-msg';
        } else {
            typingInput.classList.add('wrong-input');
            typingFeedback.textContent = `❌ Wrong. Correct answer is «${word.phrase}»`;
            typingFeedback.className = 'typing-feedback wrong-msg';
        }

        typingInput.disabled = true;
        typingSubmitBtn.disabled = true;
        typingNextBtn.disabled = false;
        typingCurrentCompleted = true;
        typingScoreEl.textContent = typingScore;
        typingHintEl.textContent = 'Click on «Next», to continue';
    }

    function nextTypingQuestion() {
        if (!typingCurrentCompleted && typingIndex < typingOrder.length) return;
        typingIndex++;
        renderTypingQuestion();
    }

    function resetTyping() {
        typingOrder = shuffleArray([...Array(wordList.length).keys()]);
        typingIndex = 0;
        typingScore = 0;
        typingAnswered = 0;
        typingCurrentCompleted = false;
        typingScoreEl.textContent = '0';
        typingResultEl.className = 'typing-result';
        typingResultEl.innerHTML = '';
        renderTypingQuestion();
    }

    function initTyping() {
        typingOrder = shuffleArray([...Array(wordList.length).keys()]);
        typingIndex = 0;
        typingScore = 0;
        typingAnswered = 0;
        typingCurrentCompleted = false;
        typingScoreEl.textContent = '0';
        renderTypingQuestion();

        typingSubmitBtn.addEventListener('click', checkTypingAnswer);
        typingNextBtn.addEventListener('click', nextTypingQuestion);
        typingResetBtn.addEventListener('click', resetTyping);

        typingInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (typingCurrentCompleted) nextTypingQuestion();
                else checkTypingAnswer();
            }
        });
    }

    // ============================================================
    //  ENVIRONMENT GAP FILL
    // ============================================================
    const gapSentences = [
        {
            text: "The Earth's atmosphere ___ because of too much carbon dioxide.",
            base: "to heat up",
            accepted: ["is heating up", "heats up", "is heated up", "heat up", "has heated up"],
            
        },
        {
            text: "Many factories ___ harmful gases into the air every day.",
            base: "to give off",
            accepted: ["give off", "gave off", "are giving off", "have given off", "gives off"],
            
        },
        {
            text: "We need to ___ on the amount of plastic we produce.",
            base: "to cut down",
            accepted: ["cut down", "to cut down", "cutting down"],
            
        },
        {
            text: "Many species of animals will ___ if we don't protect their habitats.",
            base: "to die out",
            accepted: ["die out", "to die out", "have died out", "be dying out"],
           
        },
        {
            text: "Fossil fuels will ___ sooner or later, so we need renewable energy.",
            base: "to run out",
            accepted: ["run out", "to run out", "have run out", "be running out"],
            
        },
        {
            text: "If we ___ all natural resources, future generations will suffer.",
            base: "to use up",
            accepted: ["use up", "used up", "have used up", "are using up"],
            
        },
        {
            text: "Scientists must ___ their research to find new ways to save the planet.",
            base: "to carry on",
            accepted: ["carry on", "to carry on", "carrying on", "have carried on"],
            
        },
        {
            text: "We should ___ our planet and its ecosystems better.",
            base: "to look after",
            accepted: ["look after", "to look after", "looking after", "have looked after"],
           
        },
        {
            text: "Some governments ___ taking action on climate change, which is dangerous.",
            base: "to put off",
            accepted: ["put off", "are putting off", "have put off", "to put off"],
                    },
        {
            text: "Scientists need to ___ new technologies to reduce pollution.",
            base: "to come up with",
            accepted: ["come up with", "to come up with", "coming up with", "have come up with"],
           
        }
    ];

    const GAP_TOTAL = gapSentences.length;
    let gapUserAnswers = new Array(GAP_TOTAL).fill('');
    let gapChecked = false;
    let gapScore = 0;

    const gapSentencesContainer = document.getElementById('gapSentencesContainer');
    const gapFilledCountEl = document.getElementById('gapFilledCount');
    const gapScoreEl = document.getElementById('gapScore');
    const gapProgressBar = document.getElementById('gapProgressBar');
    const gapCheckBtn = document.getElementById('gapCheckBtn');
    const gapResetBtn = document.getElementById('gapResetBtn');
    const gapResultEl = document.getElementById('gapResult');

    function renderGapSentences() {
        gapSentencesContainer.innerHTML = '';

        gapSentences.forEach((item, idx) => {
            const sentenceDiv = document.createElement('div');
            sentenceDiv.className = 'gap-sentence';
            sentenceDiv.id = `gap-sentence-${idx}`;

            const parts = item.text.split('___');

            const numSpan = document.createElement('span');
            numSpan.className = 'gap-num';
            numSpan.textContent = idx + 1;
            sentenceDiv.appendChild(numSpan);

            if (parts[0]) {
                sentenceDiv.appendChild(document.createTextNode(parts[0]));
            }

            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'gap-input';
            input.dataset.gapIndex = idx;
            input.placeholder = '...';
            input.autocomplete = 'off';
            input.autocapitalize = 'off';
            input.spellcheck = false;
            input.value = gapUserAnswers[idx] || '';
            input.disabled = gapChecked;

            if (gapChecked) {
                const normalizedUser = normalizeAnswer(gapUserAnswers[idx]);
                const isCorrect = item.accepted.some(acc => normalizeAnswer(acc) === normalizedUser);
                input.classList.add(isCorrect ? 'correct-input' : 'wrong-input');
            }

            input.addEventListener('input', (e) => {
                gapUserAnswers[idx] = e.target.value;
                updateGapProgress();
            });

            sentenceDiv.appendChild(input);

            if (parts[1]) {
                sentenceDiv.appendChild(document.createTextNode(parts[1]));
            }

            const correction = document.createElement('span');
            correction.className = 'gap-correction';
            correction.textContent = `→ ${item.accepted[0]}`;
            sentenceDiv.appendChild(correction);

            if (item.hint) {
                const hintDiv = document.createElement('div');
                hintDiv.className = 'gap-hint-line';
                hintDiv.textContent = '💡 ' + item.hint;
                sentenceDiv.appendChild(hintDiv);
            }

            gapSentencesContainer.appendChild(sentenceDiv);
        });

        updateGapProgress();
    }

    function updateGapProgress() {
        const filled = gapUserAnswers.filter(a => a.trim() !== '').length;
        gapFilledCountEl.textContent = filled;
        const percent = (filled / GAP_TOTAL) * 100;
        gapProgressBar.style.width = `${percent}%`;
        gapCheckBtn.disabled = gapChecked || filled === 0;
    }

    function checkGapFill() {
        if (gapChecked) return;

        let correct = 0;
        gapSentences.forEach((item, idx) => {
            const normalizedUser = normalizeAnswer(gapUserAnswers[idx]);
            const isCorrect = item.accepted.some(acc => normalizeAnswer(acc) === normalizedUser);
            if (isCorrect) correct++;
        });

        gapScore = correct;
        gapChecked = true;
        gapScoreEl.textContent = correct;

        renderGapSentences();

        const total = GAP_TOTAL;
        gapResultEl.className = 'gap-result show';
        if (correct === total) {
            gapResultEl.classList.add('perfect');
            gapResultEl.innerHTML = `🏆 Perfect! You have filled in all ${total} gaps! Your score: <strong>${correct} / ${total}</strong> points.`;
        } else if (correct >= total / 2) {
            gapResultEl.classList.add('good');
            gapResultEl.innerHTML = `👍 Good! You have got <strong>${correct} / ${total}</strong> points. Check the correct answers and try again later.`;
        } else {
            gapResultEl.classList.add('poor');
            gapResultEl.innerHTML = `🤔 You have got <strong>${correct} / ${total}</strong> points. Revise phrasal verbs and try again later.`;
        }

        gapCheckBtn.disabled = true;
    }

    function resetGapFill() {
        gapUserAnswers = new Array(GAP_TOTAL).fill('');
        gapChecked = false;
        gapScore = 0;
        gapScoreEl.textContent = '0';
        gapResultEl.className = 'gap-result';
        gapResultEl.innerHTML = '';
        renderGapSentences();
    }

    function initGapFill() {
        gapUserAnswers = new Array(GAP_TOTAL).fill('');
        gapChecked = false;
        gapScore = 0;
        gapScoreEl.textContent = '0';
        renderGapSentences();

        gapCheckBtn.addEventListener('click', checkGapFill);
        gapResetBtn.addEventListener('click', resetGapFill);
    }

    // ============================================================
    //  ЗАПУСК
    // ============================================================
    initQuiz();
    initFlashcards();
    initFlashcardsEn();
    initMatching();
    initTyping();
    initGapFill();
</script>
</body>
</html>
