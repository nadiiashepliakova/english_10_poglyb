    function shuffleArray(arr) {
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    function getFourOptions(correctTranslation, allTranslations) {
        const wrongCandidates = allTranslations.filter(t => t !== correctTranslation);
        shuffleArray(wrongCandidates);
        const selectedWrong = wrongCandidates.slice(0, 3);
        while (selectedWrong.length < 3) selectedWrong.push("—");
        return shuffleArray([correctTranslation, ...selectedWrong]);
    }

    function updateStats() {
        scoreCorrectEl.textContent = correctCount;
        scoreTotalEl.textContent = totalAnswered;
        const remaining = wordList.length - totalAnswered;
        remainingCountEl.textContent = remaining >= 0 ? remaining : 0;
    }

    function renderQuestion() {
        if (currentIndex >= shuffledWords.length) {
            questionTextEl.textContent = "🎉 You have learned all the words!";
            questionHintEl.textContent = "Click on Try again to revise";
            optionsContainer.innerHTML = '';
            feedbackEl.textContent = `Your result: ${correctCount} out of ${totalAnswered}`;
            feedbackEl.className = 'feedback correct-msg';
            nextButton.disabled = true;
            currentQuestionCompleted = true;
            return;
        }

        const currentWord = shuffledWords[currentIndex];
        questionTextEl.textContent = currentWord.phrase;
        questionHintEl.textContent = '';

        const allTranslations = wordList.map(w => w.translation);
        const options = getFourOptions(currentWord.translation, allTranslations);

        optionsContainer.innerHTML = '';
        options.forEach(opt => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.textContent = opt;
            btn.dataset.translation = opt;
            btn.addEventListener('click', (e) => handleOptionClick(e, currentWord.translation));
            optionsContainer.appendChild(btn);
        });

        currentQuestionCompleted = false;
        feedbackEl.textContent = '';
        feedbackEl.className = 'feedback';
        nextButton.disabled = true;
        updateStats();
    }

    function handleOptionClick(event, correctTranslation) {
        if (currentQuestionCompleted) return;
        const clickedBtn = event.currentTarget;
        const isCorrect = clickedBtn.dataset.translation === correctTranslation;

        optionsContainer.querySelectorAll('.option-btn').forEach(btn => {
            btn.disabled = true;
            if (btn.dataset.translation === correctTranslation) btn.classList.add('correct');
            else if (btn === clickedBtn && !isCorrect) btn.classList.add('wrong');
        });

        totalAnswered++;
        if (isCorrect) {
            correctCount++;
            feedbackEl.textContent = '✅ Correct! Well Done!';
            feedbackEl.className = 'feedback correct-msg';
        } else {
            feedbackEl.textContent = `❌ Wrong. The correct answer is «${correctTranslation}»`;
            feedbackEl.className = 'feedback wrong-msg';
        }
        currentQuestionCompleted = true;
        nextButton.disabled = false;
        updateStats();
    }

    function goToNext() {
        if (!currentQuestionCompleted) return;
        currentIndex++;
