<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Тренажер: Фразові дієслова</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-text-size-adjust: 100%; }
        body {
            font-family: 'Segoe UI', Roboto, system-ui, -apple-system, sans-serif;
            background: linear-gradient(145deg, #f5f7fa 0%, #e9edf5 100%);
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 12px;
            padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
        }
        .card {
            background: #ffffff;
            max-width: 840px;
            width: 100%;
            border-radius: 32px;
            box-shadow: 0 20px 40px -12px rgba(0, 20, 30, 0.25), 0 4px 18px rgba(0, 0, 0, 0.05);
            padding: clamp(16px, 4vw, 32px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            margin-top: 8px;
        }
        h1 {
            font-size: clamp(1.25rem, 3.5vw, 1.8rem);
            font-weight: 600;
            color: #1e2b3c;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            letter-spacing: -0.02em;
            flex-wrap: wrap;
        }
        h1 span {
            background: #2d4059;
            color: white;
            font-size: clamp(0.75rem, 2vw, 1.1rem);
            padding: 4px 14px;
            border-radius: 100px;
            font-weight: 500;
        }

        /* --- Вкладки: горизонтальний скрол на вузьких екранах --- */
        .tabs {
            display: flex;
            gap: 6px;
            background: #eef3f8;
            padding: 6px;
            border-radius: 60px;
            margin-bottom: 22px;
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
            scroll-behavior: smooth;
        }
        .tabs::-webkit-scrollbar { display: none; }
        .tab-btn {
            flex: 1 0 auto;
            min-width: fit-content;
            white-space: nowrap;
            background: transparent;
            border: none;
            padding: 11px 14px;
            border-radius: 40px;
            font-size: clamp(0.72rem, 1.6vw, 0.92rem);
            font-weight: 600;
            color: #4a627a;
            cursor: pointer;
            transition: all 0.15s ease;
            font-family: inherit;
        }
        .tab-btn:hover { color: #1e3a5f; }
        .tab-btn.active {
            background: white;
            color: #1e3a5f;
            box-shadow: 0 4px 12px -4px rgba(30, 58, 95, 0.25);
        }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* --- СПІЛЬНЕ --- */
        .subhead {
            color: #5a6f84;
            margin-bottom: 18px;
            font-size: clamp(0.85rem, 2vw, 0.95rem);
            border-left: 4px solid #7c9eb2;
            padding-left: 14px;
        }
        .stats {
            display: flex;
            justify-content: space-between;
            background: #eef3f8;
            padding: 12px 16px;
            border-radius: 60px;
            margin-bottom: 20px;
            font-weight: 500;
            color: #1e3a5f;
            flex-wrap: wrap;
            gap: 8px;
            font-size: clamp(0.8rem, 1.9vw, 0.95rem);
        }
        .stats i {
            font-style: normal;
            background: #cbdae8;
            border-radius: 30px;
            padding: 2px 12px;
            font-weight: 600;
        }

        /* --- ТЕСТ --- */
        .question-box {
            background: #f0f6fe;
            border-radius: 24px;
            padding: clamp(16px, 4vw, 24px) clamp(14px, 3vw, 20px);
            margin-bottom: 20px;
            border: 1px solid #d6e2ef;
            box-shadow: 0 6px 12px -6px rgba(0, 30, 60, 0.1);
        }
        .prompt {
            font-size: clamp(1.15rem, 3.5vw, 1.6rem);
            font-weight: 600;
            color: #1e3a5f;
            text-align: center;
            word-break: break-word;
            line-height: 1.4;
        }
        .prompt small {
            display: block;
            font-size: clamp(0.8rem, 2vw, 0.9rem);
            font-weight: 400;
            color: #54738f;
            margin-top: 8px;
        }
        .options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin: 18px 0 10px;
        }
        .option-btn {
            background: white;
            border: 2px solid #d0deed;
            border-radius: 16px;
            padding: clamp(10px, 2.5vw, 14px) 8px;
            font-size: clamp(0.85rem, 2vw, 0.95rem);
            font-weight: 500;
            color: #1e2b3c;
            cursor: pointer;
            transition: all 0.12s ease;
            text-align: center;
            font-family: inherit;
            word-break: break-word;
        }
        .option-btn:hover:not(:disabled) {
            background: #e1edff;
            border-color: #7fa3c2;
            transform: translateY(-2px);
        }
        .option-btn.correct:disabled {
            background: #cfe8d8;
            border-color: #2e7d5e;
            color: #1b4d3a;
            opacity: 1;
        }
        .option-btn.wrong:disabled {
            background: #ffdede;
            border-color: #c25b5b;
            color: #8b2f2f;
            opacity: 1;
            text-decoration: line-through 2px rgba(180, 60, 60, 0.4);
        }
        .option-btn:disabled { cursor: default; }
        .feedback {
            min-height: 46px;
            text-align: center;
            font-size: clamp(0.88rem, 2vw, 1rem);
            font-weight: 500;
            margin: 14px 0 8px;
            padding: 10px 16px;
            border-radius: 60px;
            background: #f8fafd;
        }
        .feedback.correct-msg { background: #dff0e6; color: #1b6b4a; }
        .feedback.wrong-msg { background: #ffe8e8; color: #b13e3e; }
        .btn {
            background: #2d4059;
            border: 1px solid #1e2b3c;
            color: white;
            font-weight: 600;
            font-size: clamp(0.9rem, 2.2vw, 1rem);
            padding: clamp(12px, 3vw, 15px) clamp(18px, 4vw, 28px);
            border-radius: 60px;
            width: 100%;
            cursor: pointer;
            transition: all 0.15s;
            font-family: inherit;
        }
        .btn:hover:not(:disabled) { background: #1f2e42; }
        .btn:disabled { background: #b7c6d8; cursor: not-allowed; border-color: #a0b2c5; }
        .reset-container { display: flex; justify-content: flex-end; margin-top: 12px; }
        .reset-btn {
            background: transparent;
            border: 2px solid #cbdae8;
            color: #3e5e7a;
            padding: 9px 18px;
            border-radius: 40px;
            font-weight: 600;
            font-size: clamp(0.8rem, 1.9vw, 0.9rem);
            cursor: pointer;
            transition: all 0.12s;
            font-family: inherit;
        }
        .reset-btn:hover { background: #e9f0f8; border-color: #90aec9; }

        /* --- FLASH-КАРТКИ --- */
        .flash-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            gap: 8px;
            flex-wrap: wrap;
        }
        .flash-counter {
            font-weight: 600;
            color: #1e3a5f;
            background: #eef3f8;
            padding: 7px 16px;
            border-radius: 40px;
            font-size: clamp(0.82rem, 2vw, 0.95rem);
        }
        .flash-direction {
            display: flex;
            background: #eef3f8;
            border-radius: 40px;
            padding: 4px;
            gap: 4px;
            flex-wrap: wrap;
        }
        .dir-btn {
            background: transparent;
            border: none;
            padding: 7px 12px;
            border-radius: 30px;
            font-size: clamp(0.72rem, 1.8vw, 0.85rem);
            font-weight: 600;
            color: #4a627a;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.12s;
        }
        .dir-btn.active {
            background: white;
            color: #1e3a5f;
            box-shadow: 0 3px 8px -3px rgba(30, 58, 95, 0.3);
        }

        .know-panel {
            display: flex;
            gap: 8px;
            margin-bottom: 18px;
        }
        .know-btn {
            flex: 1;
            padding: clamp(10px, 2.8vw, 14px) 8px;
            border-radius: 40px;
            border: 2px solid transparent;
            font-weight: 700;
            font-size: clamp(0.85rem, 2vw, 1rem);
            cursor: pointer;
            font-family: inherit;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .know-btn.know {
            background: #e3f5ec;
            color: #1b6b4a;
            border-color: #b6e0ca;
        }
        .know-btn.know:hover {
            background: #cfeede;
            border-color: #7fc9a4;
            transform: translateY(-1px);
        }
        .know-btn.dont-know {
            background: #ffecec;
            color: #b13e3e;
            border-color: #f5c6c6;
        }
        .know-btn.dont-know:hover {
            background: #ffdede;
            border-color: #e89a9a;
            transform: translateY(-1px);
        }

        .flashcard-wrapper {
            perspective: 1400px;
            width: 100%;
            height: clamp(200px, 45vw, 280px);
            margin-bottom: 16px;
            cursor: pointer;
        }
        .flashcard {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.55s cubic-bezier(0.4, 0.2, 0.2, 1);
            transform-style: preserve-3d;
        }
        .flashcard.flipped { transform: rotateY(180deg); }
        .flashcard-face {
            position: absolute;
            inset: 0;
            backface-visibility: hidden;
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: clamp(16px, 4vw, 28px);
            text-align: center;
            box-shadow: 0 16px 30px -14px rgba(30, 58, 95, 0.35);
        }
        .flashcard-front {
            background: linear-gradient(135deg, #ffffff 0%, #eef5fc 100%);
            border: 2px solid #d0deed;
        }
        .flashcard-back {
            background: linear-gradient(135deg, #2d4059 0%, #1f2e42 100%);
            color: white;
            transform: rotateY(180deg);
            border: 2px solid #1e2b3c;
        }
        .flashcard-label {
            position: absolute;
            top: 12px;
            left: 16px;
            font-size: clamp(0.65rem, 1.5vw, 0.75rem);
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            opacity: 0.5;
        }
        .flashcard-front .flashcard-label { color: #5a7590; }
        .flashcard-back .flashcard-label { color: #a9c3db; }
        .flashcard-text {
            font-size: clamp(1.05rem, 4vw, 1.7rem);
            font-weight: 700;
            line-height: 1.35;
            word-break: break-word;
            letter-spacing: -0.01em;
        }
        .flashcard-front .flashcard-text { color: #1e3a5f; }
        .flashcard-back .flashcard-text { color: #ffffff; }
        .flashcard-hint {
            position: absolute;
            bottom: 12px;
            font-size: clamp(0.7rem, 1.6vw, 0.8rem);
            opacity: 0.55;
            font-weight: 500;
            color: #54738f;
        }
        .flashcard-back .flashcard-hint { color: #a9c3db; }

        .flash-nav {
            display: flex;
            gap: 8px;
            align-items: center;
            margin-bottom: 10px;
        }
        .flash-nav .btn {
            padding: 11px 10px;
            font-size: clamp(0.82rem, 1.9vw, 0.95rem);
        }
        .btn-outline {
            background: white;
            color: #2d4059;
            border: 2px solid #d0deed;
        }
        .btn-outline:hover:not(:disabled) { background: #eef5fc; border-color: #90aec9; }
        .btn-outline:disabled { background: #f5f8fc; color: #b7c6d8; border-color: #e2ebf4; cursor: not-allowed; }

        .flash-progress {
            height: 8px;
            background: #e4ecf4;
            border-radius: 20px;
            overflow: hidden;
            margin-top: 6px;
        }
        .flash-progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #7c9eb2, #2d4059);
            border-radius: 20px;
            transition: width 0.3s ease;
            width: 0%;
        }

        .learned-banner {
            display: none;
            text-align: center;
            background: linear-gradient(135deg, #dff0e6, #cfe8d8);
            color: #1b6b4a;
            border-radius: 24px;
            padding: clamp(16px, 4vw, 24px);
            margin-bottom: 18px;
            border: 2px solid #b6e0ca;
        }
        .learned-banner.show { display: block; }
        .learned-banner h2 {
            font-size: clamp(1.1rem, 3vw, 1.5rem);
            margin-bottom: 8px;
            color: #1b6b4a;
        }
        .learned-banner p {
            font-size: clamp(0.85rem, 2vw, 1rem);
            color: #2e7d5e;
        }

        .learned-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 10px;
            justify-content: center;
        }
        .learned-chip {
            background: white;
            border: 1px solid #b6e0ca;
            color: #1b6b4a;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: clamp(0.68rem, 1.6vw, 0.8rem);
            font-weight: 600;
        }

        /* ============================================================
           ВПРАВА НА З'ЄДНАННЯ (MATCHING)
           ============================================================ */
        .match-intro {
            background: #f0f6fe;
            border-radius: 20px;
            padding: clamp(12px, 3vw, 16px) clamp(14px, 3vw, 20px);
            margin-bottom: 18px;
            font-size: clamp(0.82rem, 1.9vw, 0.95rem);
            color: #3e5e7a;
            border: 1px solid #d6e2ef;
            line-height: 1.5;
        }
        .match-intro strong { color: #1e3a5f; }

        .match-scoreboard {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            background: #eef3f8;
            border-radius: 60px;
            padding: 10px 16px;
            margin-bottom: 18px;
            flex-wrap: wrap;
            font-weight: 600;
            color: #1e3a5f;
            font-size: clamp(0.8rem, 1.9vw, 0.95rem);
        }
        .match-scoreboard .score-badge {
            background: #2d4059;
            color: white;
            padding: 3px 12px;
            border-radius: 30px;
            font-weight: 700;
        }
        .match-scoreboard .score-badge span { color: #ffd166; }

        .match-board {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(10px, 2vw, 18px);
            margin-bottom: 18px;
        }
        .match-column {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .match-column-title {
            text-align: center;
            font-size: clamp(0.65rem, 1.5vw, 0.8rem);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #7c93a8;
            margin-bottom: 4px;
        }
        .match-item {
            background: white;
            border: 2px solid #d0deed;
            border-radius: 14px;
            padding: clamp(8px, 2vw, 12px) clamp(10px, 2.4vw, 14px);
            font-size: clamp(0.78rem, 1.9vw, 0.9rem);
            font-weight: 500;
            color: #1e2b3c;
            cursor: pointer;
            transition: all 0.15s ease;
            font-family: inherit;
            text-align: left;
            line-height: 1.4;
            position: relative;
            min-height: clamp(42px, 10vw, 52px);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .match-item:hover:not(.matched):not(.disabled) {
            background: #eef5fc;
            border-color: #90aec9;
            transform: translateY(-1px);
        }
        .match-item.selected {
            background: #fff4d6;
            border-color: #f0b429;
            box-shadow: 0 0 0 3px rgba(240, 180, 41, 0.2);
        }
        .match-item.matched {
            background: #e3f5ec;
            border-color: #7fc9a4;
            color: #1b6b4a;
            cursor: default;
        }
        .match-item.correct-pair {
            background: #dff0e6;
            border-color: #2e7d5e;
            color: #1b4d3a;
        }
        .match-item.wrong-pair {
            background: #ffe8e8;
            border-color: #c25b5b;
            color: #8b2f2f;
            text-decoration: line-through 1.5px rgba(180, 60, 60, 0.4);
        }
        .match-item.disabled {
            cursor: default;
            opacity: 0.85;
        }
        .match-item .badge {
            flex-shrink: 0;
            width: clamp(20px, 5vw, 24px);
            height: clamp(20px, 5vw, 24px);
            border-radius: 50%;
            background: #eef3f8;
            color: #5a7590;
            font-size: clamp(0.62rem, 1.5vw, 0.75rem);
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .match-item.matched .badge,
        .match-item.correct-pair .badge {
            background: #2e7d5e;
            color: white;
        }
        .match-item.wrong-pair .badge {
            background: #c25b5b;
            color: white;
        }
        .match-item .text {
            flex: 1;
            word-break: break-word;
        }

        .match-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .match-actions .btn { flex: 1; min-width: 130px; }
        .btn-check {
            background: #2e7d5e;
            border-color: #1b4d3a;
        }
        .btn-check:hover:not(:disabled) { background: #256b4f; }
        .btn-check:disabled { background: #b7c6d8; border-color: #a0b2c5; }

        .match-result {
            margin-top: 14px;
            padding: 16px 18px;
            border-radius: 20px;
            font-size: clamp(0.85rem, 2vw, 1rem);
            font-weight: 600;
            text-align: center;
            display: none;
        }
        .match-result.show { display: block; }
        .match-result.perfect {
            background: linear-gradient(135deg, #dff0e6, #cfe8d8);
            color: #1b6b4a;
            border: 2px solid #b6e0ca;
        }
        .match-result.good {
            background: #fff4d6;
            color: #8a6100;
            border: 2px solid #f5d78e;
        }
        .match-result.poor {
            background: #ffe8e8;
            color: #b13e3e;
            border: 2px solid #f5c6c6;
        }

        /* ============================================================
           ВПРАВА НА ВВЕДЕННЯ (TYPING)
           ============================================================ */
        .typing-intro {
            background: #f0f6fe;
            border-radius: 20px;
            padding: clamp(12px, 3vw, 16px) clamp(14px, 3vw, 20px);
            margin-bottom: 18px;
            font-size: clamp(0.82rem, 1.9vw, 0.95rem);
            color: #3e5e7a;
            border: 1px solid #d6e2ef;
            line-height: 1.5;
        }
        .typing-intro strong { color: #1e3a5f; }

        .typing-scoreboard {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            background: #eef3f8;
            border-radius: 60px;
            padding: 10px 16px;
            margin-bottom: 18px;
            flex-wrap: wrap;
            font-weight: 600;
            color: #1e3a5f;
            font-size: clamp(0.8rem, 1.9vw, 0.95rem);
        }
        .typing-scoreboard .score-badge {
            background: #2d4059;
            color: white;
            padding: 3px 12px;
            border-radius: 30px;
            font-weight: 700;
        }
        .typing-scoreboard .score-badge span { color: #ffd166; }

        .typing-card {
            background: #f0f6fe;
            border-radius: 24px;
            padding: clamp(16px, 4vw, 28px) clamp(14px, 3vw, 24px);
            margin-bottom: 18px;
            border: 1px solid #d6e2ef;
            box-shadow: 0 6px 12px -6px rgba(0, 30, 60, 0.1);
        }
        .typing-definition {
            font-size: clamp(1rem, 2.8vw, 1.25rem);
            font-weight: 600;
            color: #1e3a5f;
            text-align: center;
            line-height: 1.5;
            margin-bottom: 18px;
            min-height: 60px;
        }
        .typing-input-row {
            display: flex;
            gap: 8px;
        }
        .typing-input {
            flex: 1;
            min-width: 0;
            padding: 14px 18px;
            font-size: clamp(0.95rem, 2.2vw, 1.1rem);
            font-family: inherit;
            font-weight: 600;
            color: #1e3a5f;
            background: white;
            border: 2px solid #d0deed;
            border-radius: 60px;
            outline: none;
            transition: all 0.15s;
        }
        .typing-input:focus {
            border-color: #7fa3c2;
            box-shadow: 0 0 0 4px rgba(127, 163, 194, 0.2);
        }
        .typing-input:disabled {
            background: #f5f8fc;
            color: #8a9eb0;
        }
        .typing-input.correct-input {
            border-color: #2e7d5e;
            background: #e3f5ec;
            color: #1b4d3a;
        }
        .typing-input.wrong-input {
            border-color: #c25b5b;
            background: #ffe8e8;
            color: #8b2f2f;
            text-decoration: line-through 1.5px rgba(180, 60, 60, 0.4);
        }
        .btn-submit {
            background: #2e7d5e;
            border-color: #1b4d3a;
            flex: 0 0 auto;
            width: auto;
            padding: 14px 22px;
            font-size: clamp(0.88rem, 2vw, 1rem);
        }
        .btn-submit:hover:not(:disabled) { background: #256b4f; }
        .btn-submit:disabled { background: #b7c6d8; border-color: #a0b2c5; }

        .typing-feedback {
            min-height: 46px;
            text-align: center;
            font-size: clamp(0.85rem, 2vw, 1rem);
            font-weight: 500;
            margin-top: 14px;
            padding: 10px 16px;
            border-radius: 60px;
